{
  "id": "hardware/cpn_ultrasonic",
  "title": "Ultrasonic Module",
  "sections": [
    {
      "id": "ultrasonic-module",
      "level": 1,
      "title": "Ultrasonic Module",
      "anchors": [],
      "blocks": [
        {
          "t": "image",
          "src": "/content/img/hardware/img/ultrasonic_pic.png",
          "width": "400",
          "align": "center"
        },
        {
          "t": "list",
          "ordered": false,
          "items": [
            [
              {
                "t": "p",
                "inlines": [
                  {
                    "t": "strong",
                    "v": "TRIG"
                  },
                  {
                    "t": "text",
                    "v": ": Trigger Pulse Input"
                  }
                ]
              }
            ],
            [
              {
                "t": "p",
                "inlines": [
                  {
                    "t": "strong",
                    "v": "ECHO"
                  },
                  {
                    "t": "text",
                    "v": ": Echo Pulse Output"
                  }
                ]
              }
            ],
            [
              {
                "t": "p",
                "inlines": [
                  {
                    "t": "strong",
                    "v": "GND"
                  },
                  {
                    "t": "text",
                    "v": ": Ground"
                  }
                ]
              }
            ],
            [
              {
                "t": "p",
                "inlines": [
                  {
                    "t": "strong",
                    "v": "VCC"
                  },
                  {
                    "t": "text",
                    "v": ": 5V Supply"
                  }
                ]
              }
            ]
          ]
        },
        {
          "t": "p",
          "inlines": [
            {
              "t": "text",
              "v": "This is the HC-SR04 ultrasonic distance sensor, providing non-contact measurement from 2 cm to 400 cm with a range accuracy of up to 3 mm. Included on the module is an ultrasonic transmitter, a receiver and a control circuit."
            }
          ]
        },
        {
          "t": "p",
          "inlines": [
            {
              "t": "text",
              "v": "You only need to connect 4 pins: VCC (power), Trig (trigger), Echo (receive) and GND (ground) to make it easy to use for your measurement projects."
            }
          ]
        },
        {
          "t": "p",
          "inlines": [
            {
              "t": "strong",
              "v": "Features"
            }
          ]
        },
        {
          "t": "list",
          "ordered": false,
          "items": [
            [
              {
                "t": "p",
                "inlines": [
                  {
                    "t": "text",
                    "v": "Working Voltage: DC5V"
                  }
                ]
              }
            ],
            [
              {
                "t": "p",
                "inlines": [
                  {
                    "t": "text",
                    "v": "Working Current: 16mA"
                  }
                ]
              }
            ],
            [
              {
                "t": "p",
                "inlines": [
                  {
                    "t": "text",
                    "v": "Working Frequency: 40Hz"
                  }
                ]
              }
            ],
            [
              {
                "t": "p",
                "inlines": [
                  {
                    "t": "text",
                    "v": "Max Range: 500cm"
                  }
                ]
              }
            ],
            [
              {
                "t": "p",
                "inlines": [
                  {
                    "t": "text",
                    "v": "Min Range: 2cm"
                  }
                ]
              }
            ],
            [
              {
                "t": "p",
                "inlines": [
                  {
                    "t": "text",
                    "v": "Trigger Input Signal: 10uS TTL pulse"
                  }
                ]
              }
            ],
            [
              {
                "t": "p",
                "inlines": [
                  {
                    "t": "text",
                    "v": "Echo Output Signal: Input TTL lever signal and the range in proportion"
                  }
                ]
              }
            ],
            [
              {
                "t": "p",
                "inlines": [
                  {
                    "t": "text",
                    "v": "Connector: XH2.54-4P"
                  }
                ]
              }
            ],
            [
              {
                "t": "p",
                "inlines": [
                  {
                    "t": "text",
                    "v": "Dimension: 46x20.5x15 mm"
                  }
                ]
              }
            ]
          ]
        },
        {
          "t": "p",
          "inlines": [
            {
              "t": "strong",
              "v": "Principle"
            }
          ]
        },
        {
          "t": "p",
          "inlines": [
            {
              "t": "text",
              "v": "The basic principles are as follows:"
            }
          ]
        },
        {
          "t": "list",
          "ordered": false,
          "items": [
            [
              {
                "t": "p",
                "inlines": [
                  {
                    "t": "text",
                    "v": "Using IO trigger for at least 10us high level signal."
                  }
                ]
              }
            ],
            [
              {
                "t": "p",
                "inlines": [
                  {
                    "t": "text",
                    "v": "The module sends an 8 cycle burst of ultrasound at 40 kHz and detects whether a pulse signal is received."
                  }
                ]
              }
            ],
            [
              {
                "t": "p",
                "inlines": [
                  {
                    "t": "text",
                    "v": "Echo will output a high level if a signal is returned; the duration of the high level is the time from emission to return."
                  }
                ]
              }
            ],
            [
              {
                "t": "p",
                "inlines": [
                  {
                    "t": "text",
                    "v": "Distance = (high level time x velocity of sound (340M/S)) / 2"
                  }
                ]
              },
              {
                "t": "image",
                "src": "/content/img/hardware/img/ultrasonic_prin.jpg",
                "width": "800"
              }
            ]
          ]
        },
        {
          "t": "p",
          "inlines": [
            {
              "t": "text",
              "v": "Formula:"
            }
          ]
        },
        {
          "t": "list",
          "ordered": false,
          "items": [
            [
              {
                "t": "p",
                "inlines": [
                  {
                    "t": "text",
                    "v": "us / 58 = centimeters distance"
                  }
                ]
              }
            ],
            [
              {
                "t": "p",
                "inlines": [
                  {
                    "t": "text",
                    "v": "us / 148 = inch distance"
                  }
                ]
              }
            ],
            [
              {
                "t": "p",
                "inlines": [
                  {
                    "t": "text",
                    "v": "distance = high level time x velocity (340M/S) / 2"
                  }
                ]
              }
            ]
          ]
        },
        {
          "t": "p",
          "inlines": [
            {
              "t": "strong",
              "v": "Application Notes"
            }
          ]
        },
        {
          "t": "list",
          "ordered": false,
          "items": [
            [
              {
                "t": "p",
                "inlines": [
                  {
                    "t": "text",
                    "v": "This module should not be connected under power up, if necessary, let the module's GND be connected first. Otherwise, it will affect the work of the module."
                  }
                ]
              }
            ],
            [
              {
                "t": "p",
                "inlines": [
                  {
                    "t": "text",
                    "v": "The area of the object to be measured should be at least 0.5 square meters and as flat as possible. Otherwise, it will affect results."
                  }
                ]
              }
            ]
          ]
        }
      ]
    }
  ]
}