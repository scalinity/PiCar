      "blocks": [
        {
          "t": "p",
          "inlines": [
            {
              "t": "text",
              "v": "In this project, PiCar-X will detect obstacles in front of it while moving forward, and when the obstacles are too close, it will change the direction of moving forward."
            }
          ]
        },
        {
          "t": "p",
          "inlines": [
            {
              "t": "strong",
              "v": "Run the Code"
            }
          ]
        },
        {
          "t": "code",
          "lang": "text",
          "code": "cd ~/picar-x/example\nsudo python3 4.avoiding_obstacles.py",
          "runnable": true,
          "html": "<pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:light-dark(#fff, #24292e);--shiki-light-bg:#fff;--shiki-dark-bg:#24292e;color:light-dark(#24292e, #e1e4e8);--shiki-light:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span>cd ~/picar-x/example</span></span>\n<span class=\"line\"><span>sudo python3 4.avoiding_obstacles.py</span></span></code></pre>"
        },
        {
          "t": "p",
          "inlines": [
            {
              "t": "text",
              "v": "After running the code, PiCar-X will walk forward."
            }
          ]
        },
        {
          "t": "p",
          "inlines": [
            {
              "t": "text",
              "v": "If it detects that the distance of the obstacle ahead is less than 20cm, it will go backward."
            }
          ]
        },
        {
          "t": "p",
          "inlines": [
            {
              "t": "text",
              "v": "If there is an obstacle within 20 to 40cm, it will turn left."
            }
          ]
        },
        {
          "t": "p",
          "inlines": [
            {
              "t": "text",
              "v": "If there is no obstacle in the direction after turning left or the obstacle distance is greater than 25cm, it will continue to move forward."
            }
          ]
        },
        {
          "t": "p",
          "inlines": [
