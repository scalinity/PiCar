        {
          "t": "code",
          "lang": "python",
          "code": "from picarx import Picarx\nimport time\n\n\nif __name__ == \"__main__\":\n    try:\n        px = Picarx()\n        px.forward(30)\n        time.sleep(0.5)\n        for angle in range(0,35):\n            px.set_dir_servo_angle(angle)\n            time.sleep(0.01)\n        for angle in range(35,-35,-1):\n            px.set_dir_servo_angle(angle)\n            time.sleep(0.01)\n        for angle in range(-35,0):\n            px.set_dir_servo_angle(angle)\n            time.sleep(0.01)\n        px.forward(0)\n        time.sleep(1)\n\n        for angle in range(0,35):\n            px.set_camera_servo1_angle(angle)\n            time.sleep(0.01)\n        for angle in range(35,-35,-1):\n            px.set_camera_servo1_angle(angle)\n            time.sleep(0.01)\n        for angle in range(-35,0):\n            px.set_camera_servo1_angle(angle)\n            time.sleep(0.01)\n        for angle in range(0,35):\n            px.set_camera_servo2_angle(angle)\n            time.sleep(0.01)\n        for angle in range(35,-35,-1):\n            px.set_camera_servo2_angle(angle)\n            time.sleep(0.01)\n        for angle in range(-35,0):\n            px.set_camera_servo2_angle(angle)\n            time.sleep(0.01)\n\n    finally:\n        px.forward(0)",
          "runnable": true,
