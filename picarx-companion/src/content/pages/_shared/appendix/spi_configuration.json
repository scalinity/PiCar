{
  "id": "_shared/appendix/spi_configuration",
  "title": "SPI Configuration",
  "sections": [
    {
      "id": "spi-configuration",
      "level": 1,
      "title": "SPI Configuration",
      "anchors": [
        "spi_configuration"
      ],
      "blocks": [
        {
          "t": "p",
          "inlines": [
            {
              "t": "text",
              "v": "Follow the steps below to enable and verify the SPI interface on your Raspberry Pi. These instructions apply to Raspberry Pi 5, 4, 3, and Zero 2W."
            }
          ]
        }
      ]
    },
    {
      "id": "enable-the-spi-interface",
      "level": 2,
      "title": "Enable the SPI Interface",
      "anchors": [],
      "blocks": [
        {
          "t": "list",
          "ordered": true,
          "items": [
            [
              {
                "t": "p",
                "inlines": [
                  {
                    "t": "text",
                    "v": "Open a terminal on your computer (Windows: "
                  },
                  {
                    "t": "strong",
                    "v": "PowerShell"
                  },
                  {
                    "t": "text",
                    "v": "; macOS/Linux: "
                  },
                  {
                    "t": "strong",
                    "v": "Terminal"
                  },
                  {
                    "t": "text",
                    "v": ") and connect to your Raspberry Pi:"
                  }
                ]
              },
              {
                "t": "code",
                "lang": "bash",
                "code": "ssh <username>@<hostname>.local",
                "runnable": false,
                "html": "<pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:light-dark(#fff, #24292e);--shiki-light-bg:#fff;--shiki-dark-bg:#24292e;color:light-dark(#24292e, #e1e4e8);--shiki-light:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:light-dark(#6F42C1, #B392F0);--shiki-light:#6F42C1;--shiki-dark:#B392F0\">ssh</span><span style=\"color:light-dark(#D73A49, #F97583);--shiki-light:#D73A49;--shiki-dark:#F97583\"> &#x3C;</span><span style=\"color:light-dark(#032F62, #9ECBFF);--shiki-light:#032F62;--shiki-dark:#9ECBFF\">usernam</span><span style=\"color:light-dark(#24292E, #E1E4E8);--shiki-light:#24292E;--shiki-dark:#E1E4E8\">e</span><span style=\"color:light-dark(#D73A49, #F97583);--shiki-light:#D73A49;--shiki-dark:#F97583\">></span><span style=\"color:light-dark(#032F62, #9ECBFF);--shiki-light:#032F62;--shiki-dark:#9ECBFF\">@</span><span style=\"color:light-dark(#D73A49, #F97583);--shiki-light:#D73A49;--shiki-dark:#F97583\">&#x3C;</span><span style=\"color:light-dark(#032F62, #9ECBFF);--shiki-light:#032F62;--shiki-dark:#9ECBFF\">hostnam</span><span style=\"color:light-dark(#24292E, #E1E4E8);--shiki-light:#24292E;--shiki-dark:#E1E4E8\">e</span><span style=\"color:light-dark(#D73A49, #F97583);--shiki-light:#D73A49;--shiki-dark:#F97583\">></span><span style=\"color:light-dark(#032F62, #9ECBFF);--shiki-light:#032F62;--shiki-dark:#9ECBFF\">.local</span></span></code></pre>"
              },
              {
                "t": "p",
                "inlines": [
                  {
                    "t": "text",
                    "v": "or:"
                  }
                ]
              },
              {
                "t": "code",
                "lang": "bash",
                "code": "ssh <username>@<ip_address>",
                "runnable": false,
                "html": "<pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:light-dark(#fff, #24292e);--shiki-light-bg:#fff;--shiki-dark-bg:#24292e;color:light-dark(#24292e, #e1e4e8);--shiki-light:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:light-dark(#6F42C1, #B392F0);--shiki-light:#6F42C1;--shiki-dark:#B392F0\">ssh</span><span style=\"color:light-dark(#D73A49, #F97583);--shiki-light:#D73A49;--shiki-dark:#F97583\"> &#x3C;</span><span style=\"color:light-dark(#032F62, #9ECBFF);--shiki-light:#032F62;--shiki-dark:#9ECBFF\">usernam</span><span style=\"color:light-dark(#24292E, #E1E4E8);--shiki-light:#24292E;--shiki-dark:#E1E4E8\">e</span><span style=\"color:light-dark(#D73A49, #F97583);--shiki-light:#D73A49;--shiki-dark:#F97583\">></span><span style=\"color:light-dark(#032F62, #9ECBFF);--shiki-light:#032F62;--shiki-dark:#9ECBFF\">@</span><span style=\"color:light-dark(#D73A49, #F97583);--shiki-light:#D73A49;--shiki-dark:#F97583\">&#x3C;</span><span style=\"color:light-dark(#032F62, #9ECBFF);--shiki-light:#032F62;--shiki-dark:#9ECBFF\">ip_addres</span><span style=\"color:light-dark(#24292E, #E1E4E8);--shiki-light:#24292E;--shiki-dark:#E1E4E8\">s</span><span style=\"color:light-dark(#D73A49, #F97583);--shiki-light:#D73A49;--shiki-dark:#F97583\">></span></span></code></pre>"
              }
            ],
            [
              {
                "t": "p",
                "inlines": [
                  {
                    "t": "text",
                    "v": "Open the Raspberry Pi configuration tool:"
                  }
                ]
              },
              {
                "t": "code",
                "lang": "bash",
                "code": "sudo raspi-config",
                "runnable": false,
                "html": "<pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:light-dark(#fff, #24292e);--shiki-light-bg:#fff;--shiki-dark-bg:#24292e;color:light-dark(#24292e, #e1e4e8);--shiki-light:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:light-dark(#6F42C1, #B392F0);--shiki-light:#6F42C1;--shiki-dark:#B392F0\">sudo</span><span style=\"color:light-dark(#032F62, #9ECBFF);--shiki-light:#032F62;--shiki-dark:#9ECBFF\"> raspi-config</span></span></code></pre>"
              }
            ],
            [
              {
                "t": "p",
                "inlines": [
                  {
                    "t": "text",
                    "v": "Select "
                  },
                  {
                    "t": "strong",
                    "v": "Interfacing Options"
                  },
                  {
                    "t": "text",
                    "v": " and press "
                  },
                  {
                    "t": "strong",
                    "v": "Enter"
                  },
                  {
                    "t": "text",
                    "v": "."
                  }
                ]
              },
              {
                "t": "image",
                "src": "/content/img/_shared/appendix/img/ssh_interface.png",
                "align": "center"
              }
            ],
            [
              {
                "t": "p",
                "inlines": [
                  {
                    "t": "text",
                    "v": "Select "
                  },
                  {
                    "t": "strong",
                    "v": "SPI"
                  },
                  {
                    "t": "text",
                    "v": "."
                  }
                ]
              },
              {
                "t": "image",
                "src": "/content/img/_shared/appendix/img/ssh_spi_spi.png",
                "align": "center"
              }
            ],
            [
              {
                "t": "p",
                "inlines": [
                  {
                    "t": "text",
                    "v": "Choose "
                  },
                  {
                    "t": "strong",
                    "v": "<Yes>"
                  },
                  {
                    "t": "text",
                    "v": ", then "
                  },
                  {
                    "t": "strong",
                    "v": "<Ok> → <Finish>"
                  },
                  {
                    "t": "text",
                    "v": " to apply the changes. If prompted, reboot your Raspberry Pi."
                  }
                ]
              },
              {
                "t": "image",
                "src": "/content/img/_shared/appendix/img/ssh_spi_enable.png",
                "align": "center"
              }
            ]
          ]
        }
      ]
    },
    {
      "id": "verify-spi-interface",
      "level": 2,
      "title": "Verify SPI Interface",
      "anchors": [],
      "blocks": [
        {
          "t": "list",
          "ordered": true,
          "items": [
            [
              {
                "t": "p",
                "inlines": [
                  {
                    "t": "text",
                    "v": "Check whether the SPI device nodes exist:"
                  }
                ]
              },
              {
                "t": "code",
                "lang": "bash",
                "code": "ls /dev/sp*",
                "runnable": false,
                "html": "<pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:light-dark(#fff, #24292e);--shiki-light-bg:#fff;--shiki-dark-bg:#24292e;color:light-dark(#24292e, #e1e4e8);--shiki-light:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:light-dark(#6F42C1, #B392F0);--shiki-light:#6F42C1;--shiki-dark:#B392F0\">ls</span><span style=\"color:light-dark(#032F62, #9ECBFF);--shiki-light:#032F62;--shiki-dark:#9ECBFF\"> /dev/sp</span><span style=\"color:light-dark(#005CC5, #79B8FF);--shiki-light:#005CC5;--shiki-dark:#79B8FF\">*</span></span></code></pre>"
              }
            ],
            [
              {
                "t": "p",
                "inlines": [
                  {
                    "t": "text",
                    "v": "If the SPI interface is enabled, the output will include:"
                  }
                ]
              },
              {
                "t": "code",
                "lang": "text",
                "code": "/dev/spidev0.0\n/dev/spidev0.1",
                "runnable": false,
                "html": "<pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:light-dark(#fff, #24292e);--shiki-light-bg:#fff;--shiki-dark-bg:#24292e;color:light-dark(#24292e, #e1e4e8);--shiki-light:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span>/dev/spidev0.0</span></span>\n<span class=\"line\"><span>/dev/spidev0.1</span></span></code></pre>"
              },
              {
                "t": "list",
                "ordered": false,
                "items": [
                  [
                    {
                      "t": "p",
                      "inlines": [
                        {
                          "t": "text",
                          "v": "If these devices appear, SPI is active and ready to use."
                        }
                      ]
                    }
                  ],
                  [
                    {
                      "t": "p",
                      "inlines": [
                        {
                          "t": "text",
                          "v": "If not, reboot your Raspberry Pi and check again."
                        }
                      ]
                    }
                  ]
                ]
              }
            ]
          ]
        }
      ]
    },
    {
      "id": "install-spidev-python-spi-library",
      "level": 2,
      "title": "Install spidev (Python SPI Library)",
      "anchors": [],
      "blocks": [
        {
          "t": "list",
          "ordered": true,
          "items": [
            [
              {
                "t": "p",
                "inlines": [
                  {
                    "t": "text",
                    "v": "Install the "
                  },
                  {
                    "t": "lit",
                    "v": "spidev"
                  },
                  {
                    "t": "text",
                    "v": " package to use SPI in Python:"
                  }
                ]
              },
              {
                "t": "code",
                "lang": "bash",
                "code": "sudo apt install python3-spidev",
                "runnable": false,
                "html": "<pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:light-dark(#fff, #24292e);--shiki-light-bg:#fff;--shiki-dark-bg:#24292e;color:light-dark(#24292e, #e1e4e8);--shiki-light:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:light-dark(#6F42C1, #B392F0);--shiki-light:#6F42C1;--shiki-dark:#B392F0\">sudo</span><span style=\"color:light-dark(#032F62, #9ECBFF);--shiki-light:#032F62;--shiki-dark:#9ECBFF\"> apt</span><span style=\"color:light-dark(#032F62, #9ECBFF);--shiki-light:#032F62;--shiki-dark:#9ECBFF\"> install</span><span style=\"color:light-dark(#032F62, #9ECBFF);--shiki-light:#032F62;--shiki-dark:#9ECBFF\"> python3-spidev</span></span></code></pre>"
              },
              {
                "t": "p",
                "inlines": [
                  {
                    "t": "text",
                    "v": "The "
                  },
                  {
                    "t": "lit",
                    "v": "spidev"
                  },
                  {
                    "t": "text",
                    "v": " library provides access to SPI devices through the "
                  },
                  {
                    "t": "lit",
                    "v": "/dev/spidevX.Y"
                  },
                  {
                    "t": "text",
                    "v": " interface."
                  }
                ]
              }
            ]
          ]
        },
        {
          "t": "transition"
        },
        {
          "t": "p",
          "inlines": [
            {
              "t": "text",
              "v": "Your Raspberry Pi is now configured to communicate with SPI devices using both command-line tools and Python."
            }
          ]
        }
      ]
    }
  ]
}