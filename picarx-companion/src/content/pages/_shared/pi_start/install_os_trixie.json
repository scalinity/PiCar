{
  "id": "_shared/pi_start/install_os_trixie",
  "title": "Installing the Operating System",
  "sections": [
    {
      "id": "installing-the-operating-system",
      "level": 1,
      "title": "Installing the Operating System",
      "anchors": [
        "install_os"
      ],
      "blocks": [
        {
          "t": "p",
          "inlines": [
            {
              "t": "text",
              "v": "Before using your Raspberry Pi, you need to install "
            },
            {
              "t": "strong",
              "v": "Raspberry Pi OS"
            },
            {
              "t": "text",
              "v": " onto a microSD card. This guide explains how to do that using "
            },
            {
              "t": "strong",
              "v": "Raspberry Pi Imager"
            },
            {
              "t": "text",
              "v": " in a simple, beginner-friendly way."
            }
          ]
        },
        {
          "t": "p",
          "inlines": [
            {
              "t": "strong",
              "v": "Required Components"
            }
          ]
        },
        {
          "t": "list",
          "ordered": false,
          "items": [
            [
              {
                "t": "p",
                "inlines": [
                  {
                    "t": "text",
                    "v": "A computer (Windows, macOS, or Linux)"
                  }
                ]
              }
            ],
            [
              {
                "t": "p",
                "inlines": [
                  {
                    "t": "text",
                    "v": "A microSD card (16GB or larger; recommended brands: SanDisk, Samsung)"
                  }
                ]
              }
            ],
            [
              {
                "t": "p",
                "inlines": [
                  {
                    "t": "text",
                    "v": "A microSD card reader"
                  }
                ]
              }
            ]
          ]
        },
        {
          "t": "transition"
        }
      ]
    },
    {
      "id": "install-raspberry-pi-imager",
      "level": 2,
      "title": "Install Raspberry Pi Imager",
      "anchors": [],
      "blocks": [
        {
          "t": "list",
          "ordered": true,
          "items": [
            [
              {
                "t": "p",
                "inlines": [
                  {
                    "t": "text",
                    "v": "Visit the official Raspberry Pi Imager download page: "
                  },
                  {
                    "t": "link",
                    "href": "https://www.raspberrypi.com/software/",
                    "v": "Raspberry Pi Imager"
                  },
                  {
                    "t": "text",
                    "v": ". Download the correct installer for your operating system."
                  }
                ]
              },
              {
                "t": "image",
                "src": "/content/img/_shared/pi_start/img/imager_download.png",
                "width": "70%"
              }
            ],
            [
              {
                "t": "p",
                "inlines": [
                  {
                    "t": "text",
                    "v": "Follow the installation prompts (language, install path, confirmation). After installation, launch "
                  },
                  {
                    "t": "strong",
                    "v": "Raspberry Pi Imager"
                  },
                  {
                    "t": "text",
                    "v": " from your desktop or applications menu."
                  }
                ]
              },
              {
                "t": "image",
                "src": "/content/img/_shared/pi_start/img/imager_install.png",
                "width": "90%"
              }
            ]
          ]
        },
        {
          "t": "transition"
        }
      ]
    },
    {
      "id": "install-the-os-to-the-microsd-card",
      "level": 2,
      "title": "Install the OS to the microSD Card",
      "anchors": [],
      "blocks": [
        {
          "t": "list",
          "ordered": true,
          "items": [
            [
              {
                "t": "p",
                "inlines": [
                  {
                    "t": "text",
                    "v": "Insert your microSD card into your computer using a card reader. Back up any important data before proceeding."
                  }
                ]
              },
              {
                "t": "image",
                "src": "/content/img/_shared/pi_start/img/insert_sd.png",
                "width": "90%"
              }
            ],
            [
              {
                "t": "p",
                "inlines": [
                  {
                    "t": "text",
                    "v": "When Raspberry Pi Imager opens, you will see the "
                  },
                  {
                    "t": "strong",
                    "v": "Device"
                  },
                  {
                    "t": "text",
                    "v": " page. Select your Raspberry Pi model from the list (e.g., Raspberry Pi 5, 4, 3, or Zero 2W)."
                  }
                ]
              },
              {
                "t": "image",
                "src": "/content/img/_shared/pi_start/img/imager_device.png",
                "width": "90%"
              }
            ]
          ]
        },
        {
          "t": "list",
          "ordered": true,
          "start": 3,
          "items": [
            [
              {
                "t": "p",
                "inlines": [
                  {
                    "t": "text",
                    "v": "Go to the "
                  },
                  {
                    "t": "strong",
                    "v": "OS"
                  },
                  {
                    "t": "text",
                    "v": " section and choose the recommended "
                  },
                  {
                    "t": "strong",
                    "v": "Raspberry Pi OS (64-bit)"
                  },
                  {
                    "t": "text",
                    "v": " option."
                  }
                ]
              },
              {
                "t": "image",
                "src": "/content/img/_shared/pi_start/img/imager_os.png",
                "width": "90%"
              },
              {
                "t": "admonition",
                "kind": "tip",
                "blocks": [
                  {
                    "t": "p",
                    "inlines": [
                      {
                        "t": "text",
                        "v": "Do not install the 32-bit version, as some required dependencies may not be available on it."
                      }
                    ]
                  }
                ]
              }
            ]
          ]
        },
        {
          "t": "list",
          "ordered": true,
          "start": 4,
          "items": [
            [
              {
                "t": "p",
                "inlines": [
                  {
                    "t": "text",
                    "v": "In the "
                  },
                  {
                    "t": "strong",
                    "v": "Storage"
                  },
                  {
                    "t": "text",
                    "v": " section, select your microSD card."
                  }
                ]
              },
              {
                "t": "image",
                "src": "/content/img/_shared/pi_start/img/imager_storage.png",
                "width": "90%"
              }
            ]
          ]
        },
        {
          "t": "transition"
        }
      ]
    },
    {
      "id": "os-customization-settings",
      "level": 2,
      "title": "OS Customization Settings",
      "anchors": [
        "imager_custom"
      ],
      "blocks": [
        {
          "t": "list",
          "ordered": true,
          "items": [
            [
              {
                "t": "p",
                "inlines": [
                  {
                    "t": "text",
                    "v": "Continue to the customization step."
                  }
                ]
              },
              {
                "t": "list",
                "ordered": false,
                "items": [
                  [
                    {
                      "t": "p",
                      "inlines": [
                        {
                          "t": "text",
                          "v": "If you will connect a monitor, keyboard, and mouse directly to your Raspberry Pi, you may click "
                        },
                        {
                          "t": "strong",
                          "v": "SKIP CUSTOMISATION"
                        },
                        {
                          "t": "text",
                          "v": "."
                        }
                      ]
                    }
                  ],
                  [
                    {
                      "t": "p",
                      "inlines": [
                        {
                          "t": "text",
                          "v": "If you plan to set up the Raspberry Pi "
                        },
                        {
                          "t": "em",
                          "v": "headless"
                        },
                        {
                          "t": "text",
                          "v": " (Wi-Fi remote access), you must complete the customization settings."
                        }
                      ]
                    }
                  ]
                ]
              },
              {
                "t": "image",
                "src": "/content/img/_shared/pi_start/img/imager_custom_skip.png",
                "width": "90%"
              }
            ],
            [
              {
                "t": "p",
                "inlines": [
                  {
                    "t": "strong",
                    "v": "Set Hostname"
                  }
                ]
              },
              {
                "t": "list",
                "ordered": false,
                "items": [
                  [
                    {
                      "t": "p",
                      "inlines": [
                        {
                          "t": "text",
                          "v": "Give your Raspberry Pi a unique hostname."
                        }
                      ]
                    }
                  ],
                  [
                    {
                      "t": "p",
                      "inlines": [
                        {
                          "t": "text",
                          "v": "You can connect to it later using "
                        },
                        {
                          "t": "lit",
                          "v": "hostname.local"
                        },
                        {
                          "t": "text",
                          "v": "."
                        }
                      ]
                    }
                  ]
                ]
              },
              {
                "t": "image",
                "src": "/content/img/_shared/pi_start/img/imager_custom_hostname.png",
                "width": "90%"
              }
            ],
            [
              {
                "t": "p",
                "inlines": [
                  {
                    "t": "strong",
                    "v": "Set Localisation"
                  }
                ]
              },
              {
                "t": "list",
                "ordered": false,
                "items": [
                  [
                    {
                      "t": "p",
                      "inlines": [
                        {
                          "t": "text",
                          "v": "Choose your capital city."
                        }
                      ]
                    }
                  ],
                  [
                    {
                      "t": "p",
                      "inlines": [
                        {
                          "t": "text",
                          "v": "Imager will auto-complete the time zone and keyboard layout based on your selection, though you can adjust them if needed. Select Next."
                        }
                      ]
                    }
                  ]
                ]
              },
              {
                "t": "image",
                "src": "/content/img/_shared/pi_start/img/imager_custom_local.png",
                "width": "90%"
              }
            ],
            [
              {
                "t": "p",
                "inlines": [
                  {
                    "t": "strong",
                    "v": "Set Username & Password"
                  }
                ]
              },
              {
                "t": "p",
                "inlines": [
                  {
                    "t": "text",
                    "v": "Create a user account for your Raspberry Pi."
                  }
                ]
              },
              {
                "t": "image",
                "src": "/content/img/_shared/pi_start/img/imager_custom_user.png",
                "width": "90%"
              }
            ],
            [
              {
                "t": "p",
                "inlines": [
                  {
                    "t": "strong",
                    "v": "Configure Wi-Fi"
                  }
                ]
              },
              {
                "t": "list",
                "ordered": false,
                "items": [
                  [
                    {
                      "t": "p",
                      "inlines": [
                        {
                          "t": "text",
                          "v": "Enter your Wi-Fi "
                        },
                        {
                          "t": "strong",
                          "v": "SSID"
                        },
                        {
                          "t": "text",
                          "v": " (network name) and "
                        },
                        {
                          "t": "strong",
                          "v": "password"
                        },
                        {
                          "t": "text",
                          "v": "."
                        }
                      ]
                    }
                  ],
                  [
                    {
                      "t": "p",
                      "inlines": [
                        {
                          "t": "text",
                          "v": "Your Raspberry Pi will automatically connect on first boot."
                        }
                      ]
                    }
                  ]
                ]
              },
              {
                "t": "image",
                "src": "/content/img/_shared/pi_start/img/imager_custom_wifi.png",
                "width": "90%"
              }
            ],
            [
              {
                "t": "p",
                "inlines": [
                  {
                    "t": "strong",
                    "v": "Enable SSH (Optional but Recommended)"
                  }
                ]
              },
              {
                "t": "list",
                "ordered": false,
                "items": [
                  [
                    {
                      "t": "p",
                      "inlines": [
                        {
                          "t": "text",
                          "v": "Enabling SSH allows you to remotely log in from your computer."
                        }
                      ]
                    }
                  ],
                  [
                    {
                      "t": "p",
                      "inlines": [
                        {
                          "t": "text",
                          "v": "You may log in using your username/password or configure SSH keys."
                        }
                      ]
                    }
                  ]
                ]
              },
              {
                "t": "image",
                "src": "/content/img/_shared/pi_start/img/imager_custom_ssh.png",
                "width": "90%"
              }
            ]
          ]
        },
        {
          "t": "list",
          "ordered": true,
          "items": [
            [
              {
                "t": "p",
                "inlines": [
                  {
                    "t": "strong",
                    "v": "Enable Raspberry Pi Connect (Optional)"
                  }
                ]
              },
              {
                "t": "p",
                "inlines": [
                  {
                    "t": "text",
                    "v": "Raspberry Pi Connect allows you to access your Raspberry Pi desktop from a web browser."
                  }
                ]
              },
              {
                "t": "list",
                "ordered": false,
                "items": [
                  [
                    {
                      "t": "p",
                      "inlines": [
                        {
                          "t": "text",
                          "v": "Turn on "
                        },
                        {
                          "t": "strong",
                          "v": "Raspberry Pi Connect"
                        },
                        {
                          "t": "text",
                          "v": ", then click "
                        },
                        {
                          "t": "strong",
                          "v": "OPEN RASPBERRY PI CONNECT"
                        },
                        {
                          "t": "text",
                          "v": "."
                        }
                      ]
                    },
                    {
                      "t": "image",
                      "src": "/content/img/_shared/pi_start/img/imager_custom_connect.png",
                      "width": "90%"
                    }
                  ],
                  [
                    {
                      "t": "p",
                      "inlines": [
                        {
                          "t": "text",
                          "v": "The Raspberry Pi Connect website will open in your default browser. Log in to your Raspberry Pi ID account, or sign up if you don’t have one yet."
                        }
                      ]
                    },
                    {
                      "t": "image",
                      "src": "/content/img/_shared/pi_start/img/imager_custom_open.png",
                      "width": "90%"
                    }
                  ],
                  [
                    {
                      "t": "p",
                      "inlines": [
                        {
                          "t": "text",
                          "v": "On the "
                        },
                        {
                          "t": "strong",
                          "v": "New auth key"
                        },
                        {
                          "t": "text",
                          "v": " page, create your one-time auth key."
                        }
                      ]
                    },
                    {
                      "t": "list",
                      "ordered": false,
                      "items": [
                        [
                          {
                            "t": "p",
                            "inlines": [
                              {
                                "t": "text",
                                "v": "If your Raspberry Pi ID account isn’t part of any organisation, select "
                              },
                              {
                                "t": "strong",
                                "v": "Create auth key and launch Raspberry Pi Imager"
                              },
                              {
                                "t": "text",
                                "v": "."
                              }
                            ]
                          }
                        ],
                        [
                          {
                            "t": "p",
                            "inlines": [
                              {
                                "t": "text",
                                "v": "If you belong to one or more organisations, choose one, then create the key and launch Imager."
                              }
                            ]
                          }
                        ],
                        [
                          {
                            "t": "p",
                            "inlines": [
                              {
                                "t": "text",
                                "v": "Make sure to power on your Raspberry Pi and connect it to the internet before the key expires."
                              }
                            ]
                          }
                        ]
                      ]
                    },
                    {
                      "t": "image",
                      "src": "/content/img/_shared/pi_start/img/imager_custom_authkey.png",
                      "width": "90%"
                    }
                  ],
                  [
                    {
                      "t": "p",
                      "inlines": [
                        {
                          "t": "text",
                          "v": "Your browser may ask to open Raspberry Pi Imager — allow it."
                        }
                      ]
                    },
                    {
                      "t": "list",
                      "ordered": false,
                      "items": [
                        [
                          {
                            "t": "p",
                            "inlines": [
                              {
                                "t": "text",
                                "v": "Imager will open on the Raspberry Pi Connect tab, showing the authentication token."
                              }
                            ]
                          }
                        ],
                        [
                          {
                            "t": "p",
                            "inlines": [
                              {
                                "t": "text",
                                "v": "If the token doesn’t transfer automatically, open the "
                              },
                              {
                                "t": "strong",
                                "v": "Having trouble?"
                              },
                              {
                                "t": "text",
                                "v": " section on the Raspberry Pi Connect page, copy the token, and paste it into Imager manually."
                              }
                            ]
                          }
                        ]
                      ]
                    },
                    {
                      "t": "image",
                      "src": "/content/img/_shared/pi_start/img/imager_custom_connect_token.png",
                      "width": "90%"
                    }
                  ]
                ]
              }
            ]
          ]
        },
        {
          "t": "transition"
        }
      ]
    },
    {
      "id": "write-the-os-image",
      "level": 2,
      "title": "Write the OS Image",
      "anchors": [],
      "blocks": [
        {
          "t": "list",
          "ordered": true,
          "items": [
            [
              {
                "t": "p",
                "inlines": [
                  {
                    "t": "text",
                    "v": "Review all settings and click "
                  },
                  {
                    "t": "strong",
                    "v": "WRITE"
                  },
                  {
                    "t": "text",
                    "v": "."
                  }
                ]
              },
              {
                "t": "image",
                "src": "/content/img/_shared/pi_start/img/imager_writing.png",
                "width": "90%"
              }
            ],
            [
              {
                "t": "p",
                "inlines": [
                  {
                    "t": "text",
                    "v": "If the card already contains data, Raspberry Pi Imager will show a warning that all data on the device will be erased. Double-check that you selected the correct drive, then click "
                  },
                  {
                    "t": "strong",
                    "v": "I UNDERSTAND, ERASE AND WRITE"
                  },
                  {
                    "t": "text",
                    "v": " to continue."
                  }
                ]
              },
              {
                "t": "image",
                "src": "/content/img/_shared/pi_start/img/imager_erase.png",
                "width": "90%"
              }
            ],
            [
              {
                "t": "p",
                "inlines": [
                  {
                    "t": "text",
                    "v": "Wait for the writing and verification to finish. When it is done, Raspberry Pi Imager will show "
                  },
                  {
                    "t": "strong",
                    "v": "Write complete!"
                  },
                  {
                    "t": "text",
                    "v": " and a summary of your choices. The storage device will be ejected automatically so you can remove it safely."
                  }
                ]
              },
              {
                "t": "image",
                "src": "/content/img/_shared/pi_start/img/imager_finish.png",
                "width": "90%"
              }
            ],
            [
              {
                "t": "p",
                "inlines": [
                  {
                    "t": "text",
                    "v": "Remove the microSD card and insert it into the slot on the underside of your Raspberry Pi. Your Raspberry Pi is now ready to boot with the new OS!"
                  }
                ]
              },
              {
                "t": "image",
                "src": "/content/img/_shared/pi_start/img/os_sd_to_pi.jpg",
                "width": "70%"
              }
            ]
          ]
        }
      ]
    }
  ]
}