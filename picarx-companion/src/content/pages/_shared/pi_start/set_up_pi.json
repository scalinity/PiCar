{
  "id": "_shared/pi_start/set_up_pi",
  "title": "Set Up Your Raspberry Pi",
  "sections": [
    {
      "id": "set-up-your-raspberry-pi",
      "level": 1,
      "title": "Set Up Your Raspberry Pi",
      "anchors": [],
      "blocks": [
        {
          "t": "p",
          "inlines": [
            {
              "t": "text",
              "v": "To begin programming and controlling your Raspberry Pi, you first need to access it. This guide describes two common methods:"
            }
          ]
        },
        {
          "t": "list",
          "ordered": false,
          "items": [
            [
              {
                "t": "p",
                "inlines": [
                  {
                    "t": "text",
                    "v": "Using a monitor, keyboard, and mouse"
                  }
                ]
              }
            ],
            [
              {
                "t": "p",
                "inlines": [
                  {
                    "t": "text",
                    "v": "Setting up a headless (no-screen) connection for remote access"
                  }
                ]
              }
            ]
          ]
        },
        {
          "t": "admonition",
          "kind": "note",
          "blocks": [
            {
              "t": "p",
              "inlines": [
                {
                  "t": "text",
                  "v": "The Raspberry Pi Zero 2W installed on the robot is not easy to connect to a screen. We recommend using the "
                },
                {
                  "t": "strong",
                  "v": "headless setup"
                },
                {
                  "t": "text",
                  "v": " method."
                }
              ]
            }
          ]
        },
        {
          "t": "p",
          "inlines": [
            {
              "t": "text",
              "v": "-------------------------"
            }
          ]
        }
      ]
    },
    {
      "id": "if-you-have-a-screen",
      "level": 2,
      "title": "If You Have a Screen",
      "anchors": [],
      "blocks": [
        {
          "t": "p",
          "inlines": [
            {
              "t": "strong",
              "v": "Required Components"
            }
          ]
        },
        {
          "t": "list",
          "ordered": false,
          "items": [
            [
              {
                "t": "p",
                "inlines": [
                  {
                    "t": "text",
                    "v": "Raspberry Pi"
                  }
                ]
              }
            ],
            [
              {
                "t": "p",
                "inlines": [
                  {
                    "t": "text",
                    "v": "Official Power Supply"
                  }
                ]
              }
            ],
            [
              {
                "t": "p",
                "inlines": [
                  {
                    "t": "text",
                    "v": "MicroSD Card"
                  }
                ]
              }
            ],
            [
              {
                "t": "p",
                "inlines": [
                  {
                    "t": "text",
                    "v": "HDMI Cable (For Raspberry Pi 4/5, use "
                  },
                  {
                    "t": "strong",
                    "v": "HDMI0"
                  },
                  {
                    "t": "text",
                    "v": ", the port nearest the power connector.)"
                  }
                ]
              }
            ],
            [
              {
                "t": "p",
                "inlines": [
                  {
                    "t": "text",
                    "v": "Monitor"
                  }
                ]
              }
            ],
            [
              {
                "t": "p",
                "inlines": [
                  {
                    "t": "text",
                    "v": "Keyboard and Mouse"
                  }
                ]
              }
            ]
          ]
        },
        {
          "t": "p",
          "inlines": [
            {
              "t": "strong",
              "v": "Steps"
            }
          ]
        },
        {
          "t": "list",
          "ordered": true,
          "items": [
            [
              {
                "t": "p",
                "inlines": [
                  {
                    "t": "text",
                    "v": "Insert the microSD card into your Raspberry Pi."
                  }
                ]
              }
            ],
            [
              {
                "t": "p",
                "inlines": [
                  {
                    "t": "text",
                    "v": "Connect the keyboard, mouse, and monitor."
                  }
                ]
              }
            ],
            [
              {
                "t": "p",
                "inlines": [
                  {
                    "t": "text",
                    "v": "Power on your Raspberry Pi."
                  }
                ]
              }
            ],
            [
              {
                "t": "p",
                "inlines": [
                  {
                    "t": "text",
                    "v": "After booting, the Raspberry Pi OS desktop will appear."
                  }
                ]
              },
              {
                "t": "image",
                "src": "/content/img/_shared/pi_start/img/plug_screen_trixie.png",
                "width": "80%",
                "align": "center"
              }
            ],
            [
              {
                "t": "p",
                "inlines": [
                  {
                    "t": "text",
                    "v": "Open a "
                  },
                  {
                    "t": "strong",
                    "v": "Terminal"
                  },
                  {
                    "t": "text",
                    "v": " to enter commands."
                  }
                ]
              },
              {
                "t": "image",
                "src": "/content/img/_shared/pi_start/img/open_terminal.png",
                "width": "80%",
                "align": "center"
              }
            ]
          ]
        },
        {
          "t": "p",
          "inlines": [
            {
              "t": "text",
              "v": "----------------------------------"
            }
          ]
        }
      ]
    },
    {
      "id": "if-you-have-no-screen-headless",
      "level": 2,
      "title": "If You Have No Screen (Headless)",
      "anchors": [],
      "blocks": [
        {
          "t": "p",
          "inlines": [
            {
              "t": "text",
              "v": "Without a monitor, you can configure and log in to your Raspberry Pi remotely. This is the most convenient method for most users."
            }
          ]
        },
        {
          "t": "p",
          "inlines": [
            {
              "t": "strong",
              "v": "Required Components"
            }
          ]
        },
        {
          "t": "list",
          "ordered": false,
          "items": [
            [
              {
                "t": "p",
                "inlines": [
                  {
                    "t": "text",
                    "v": "Raspberry Pi"
                  }
                ]
              }
            ],
            [
              {
                "t": "p",
                "inlines": [
                  {
                    "t": "text",
                    "v": "Official Power Supply"
                  }
                ]
              }
            ],
            [
              {
                "t": "p",
                "inlines": [
                  {
                    "t": "text",
                    "v": "MicroSD Card"
                  }
                ]
              }
            ],
            [
              {
                "t": "p",
                "inlines": [
                  {
                    "t": "text",
                    "v": "A computer on the same network"
                  }
                ]
              }
            ]
          ]
        },
        {
          "t": "p",
          "inlines": [
            {
              "t": "strong",
              "v": "Tips"
            }
          ]
        },
        {
          "t": "list",
          "ordered": false,
          "items": [
            [
              {
                "t": "p",
                "inlines": [
                  {
                    "t": "text",
                    "v": "Make sure you have completed all settings described in "
                  },
                  {
                    "t": "xref",
                    "page": "_shared/pi_start/install_os_trixie",
                    "section": "os-customization-settings",
                    "v": "OS Customization Settings"
                  },
                  {
                    "t": "text",
                    "v": " when installing the system with Raspberry Pi Imager."
                  }
                ]
              }
            ],
            [
              {
                "t": "p",
                "inlines": [
                  {
                    "t": "text",
                    "v": "Ensure that your Raspberry Pi and your computer are on the same local network."
                  }
                ]
              }
            ],
            [
              {
                "t": "p",
                "inlines": [
                  {
                    "t": "text",
                    "v": "For best stability, use Ethernet if available."
                  }
                ]
              }
            ]
          ]
        },
        {
          "t": "p",
          "inlines": [
            {
              "t": "strong",
              "v": "Connect via SSH"
            }
          ]
        },
        {
          "t": "list",
          "ordered": true,
          "items": [
            [
              {
                "t": "p",
                "inlines": [
                  {
                    "t": "text",
                    "v": "Open a terminal on your computer (Windows: "
                  },
                  {
                    "t": "strong",
                    "v": "PowerShell"
                  },
                  {
                    "t": "text",
                    "v": "; macOS/Linux: "
                  },
                  {
                    "t": "strong",
                    "v": "Terminal"
                  },
                  {
                    "t": "text",
                    "v": ") and connect to your Raspberry Pi:"
                  }
                ]
              },
              {
                "t": "code",
                "lang": "bash",
                "code": "ssh <username>@<hostname>.local\n# Example:\nssh daisy@pi.local",
                "runnable": false,
                "html": "<pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:light-dark(#fff, #24292e);--shiki-light-bg:#fff;--shiki-dark-bg:#24292e;color:light-dark(#24292e, #e1e4e8);--shiki-light:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:light-dark(#6F42C1, #B392F0);--shiki-light:#6F42C1;--shiki-dark:#B392F0\">ssh</span><span style=\"color:light-dark(#D73A49, #F97583);--shiki-light:#D73A49;--shiki-dark:#F97583\"> &#x3C;</span><span style=\"color:light-dark(#032F62, #9ECBFF);--shiki-light:#032F62;--shiki-dark:#9ECBFF\">usernam</span><span style=\"color:light-dark(#24292E, #E1E4E8);--shiki-light:#24292E;--shiki-dark:#E1E4E8\">e</span><span style=\"color:light-dark(#D73A49, #F97583);--shiki-light:#D73A49;--shiki-dark:#F97583\">></span><span style=\"color:light-dark(#032F62, #9ECBFF);--shiki-light:#032F62;--shiki-dark:#9ECBFF\">@</span><span style=\"color:light-dark(#D73A49, #F97583);--shiki-light:#D73A49;--shiki-dark:#F97583\">&#x3C;</span><span style=\"color:light-dark(#032F62, #9ECBFF);--shiki-light:#032F62;--shiki-dark:#9ECBFF\">hostnam</span><span style=\"color:light-dark(#24292E, #E1E4E8);--shiki-light:#24292E;--shiki-dark:#E1E4E8\">e</span><span style=\"color:light-dark(#D73A49, #F97583);--shiki-light:#D73A49;--shiki-dark:#F97583\">></span><span style=\"color:light-dark(#032F62, #9ECBFF);--shiki-light:#032F62;--shiki-dark:#9ECBFF\">.local</span></span>\n<span class=\"line\"><span style=\"color:light-dark(#6A737D, #6A737D);--shiki-light:#6A737D;--shiki-dark:#6A737D\"># Example:</span></span>\n<span class=\"line\"><span style=\"color:light-dark(#6F42C1, #B392F0);--shiki-light:#6F42C1;--shiki-dark:#B392F0\">ssh</span><span style=\"color:light-dark(#032F62, #9ECBFF);--shiki-light:#032F62;--shiki-dark:#9ECBFF\"> daisy@pi.local</span></span></code></pre>"
              }
            ],
            [
              {
                "t": "p",
                "inlines": [
                  {
                    "t": "text",
                    "v": "Alternatively, locate your Pi’s IP address from your router’s DHCP list and connect with:"
                  }
                ]
              },
              {
                "t": "code",
                "lang": "bash",
                "code": "ssh <username>@<IP address>\n# Example:\nssh daisy@192.168.1.42",
                "runnable": false,
                "html": "<pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:light-dark(#fff, #24292e);--shiki-light-bg:#fff;--shiki-dark-bg:#24292e;color:light-dark(#24292e, #e1e4e8);--shiki-light:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:light-dark(#6F42C1, #B392F0);--shiki-light:#6F42C1;--shiki-dark:#B392F0\">ssh</span><span style=\"color:light-dark(#D73A49, #F97583);--shiki-light:#D73A49;--shiki-dark:#F97583\"> &#x3C;</span><span style=\"color:light-dark(#032F62, #9ECBFF);--shiki-light:#032F62;--shiki-dark:#9ECBFF\">usernam</span><span style=\"color:light-dark(#24292E, #E1E4E8);--shiki-light:#24292E;--shiki-dark:#E1E4E8\">e</span><span style=\"color:light-dark(#D73A49, #F97583);--shiki-light:#D73A49;--shiki-dark:#F97583\">></span><span style=\"color:light-dark(#032F62, #9ECBFF);--shiki-light:#032F62;--shiki-dark:#9ECBFF\">@</span><span style=\"color:light-dark(#D73A49, #F97583);--shiki-light:#D73A49;--shiki-dark:#F97583\">&#x3C;</span><span style=\"color:light-dark(#032F62, #9ECBFF);--shiki-light:#032F62;--shiki-dark:#9ECBFF\">IP</span><span style=\"color:light-dark(#032F62, #9ECBFF);--shiki-light:#032F62;--shiki-dark:#9ECBFF\"> addres</span><span style=\"color:light-dark(#24292E, #E1E4E8);--shiki-light:#24292E;--shiki-dark:#E1E4E8\">s</span><span style=\"color:light-dark(#D73A49, #F97583);--shiki-light:#D73A49;--shiki-dark:#F97583\">></span></span>\n<span class=\"line\"><span style=\"color:light-dark(#6A737D, #6A737D);--shiki-light:#6A737D;--shiki-dark:#6A737D\"># Example:</span></span>\n<span class=\"line\"><span style=\"color:light-dark(#6F42C1, #B392F0);--shiki-light:#6F42C1;--shiki-dark:#B392F0\">ssh</span><span style=\"color:light-dark(#032F62, #9ECBFF);--shiki-light:#032F62;--shiki-dark:#9ECBFF\"> daisy@192.168.1.42</span></span></code></pre>"
              }
            ],
            [
              {
                "t": "p",
                "inlines": [
                  {
                    "t": "text",
                    "v": "On first login, type "
                  },
                  {
                    "t": "lit",
                    "v": "yes"
                  },
                  {
                    "t": "text",
                    "v": " to confirm the SSH certificate."
                  }
                ]
              }
            ],
            [
              {
                "t": "p",
                "inlines": [
                  {
                    "t": "text",
                    "v": "Enter the password you configured in Raspberry Pi Imager. (Nothing appears while typing—this is normal.)"
                  }
                ]
              }
            ],
            [
              {
                "t": "p",
                "inlines": [
                  {
                    "t": "text",
                    "v": "After login, you now have full command-line access."
                  }
                ]
              },
              {
                "t": "image",
                "src": "/content/img/_shared/pi_start/img/ssh_login.png",
                "align": "center"
              }
            ]
          ]
        },
        {
          "t": "transition"
        },
        {
          "t": "p",
          "inlines": [
            {
              "t": "strong",
              "v": "Troubleshooting"
            }
          ]
        },
        {
          "t": "list",
          "ordered": false,
          "items": [
            [
              {
                "t": "p",
                "inlines": [
                  {
                    "t": "strong",
                    "v": "ssh: Could not resolve hostname ..."
                  }
                ]
              },
              {
                "t": "list",
                "ordered": false,
                "items": [
                  [
                    {
                      "t": "p",
                      "inlines": [
                        {
                          "t": "text",
                          "v": "Make sure the hostname is correct."
                        }
                      ]
                    }
                  ],
                  [
                    {
                      "t": "p",
                      "inlines": [
                        {
                          "t": "text",
                          "v": "Try connecting using the Pi’s IP address."
                        }
                      ]
                    }
                  ]
                ]
              }
            ],
            [
              {
                "t": "p",
                "inlines": [
                  {
                    "t": "strong",
                    "v": "The term 'ssh' is not recognized... (Windows)"
                  }
                ]
              },
              {
                "t": "list",
                "ordered": false,
                "items": [
                  [
                    {
                      "t": "p",
                      "inlines": [
                        {
                          "t": "text",
                          "v": "OpenSSH is not installed. Install it manually or use a third-party SSH client."
                        }
                      ]
                    }
                  ],
                  [
                    {
                      "t": "p",
                      "inlines": [
                        {
                          "t": "text",
                          "v": "See "
                        },
                        {
                          "t": "xref",
                          "page": "_shared/appendix/install_openssh_powershell",
                          "section": "install-openssh-via-powershell",
                          "v": "Install OpenSSH via PowerShell"
                        },
                        {
                          "t": "text",
                          "v": " or "
                        },
                        {
                          "t": "xref",
                          "page": "_shared/appendix/login_windows",
                          "section": "putty",
                          "v": "PuTTY"
                        },
                        {
                          "t": "text",
                          "v": "."
                        }
                      ]
                    }
                  ]
                ]
              }
            ],
            [
              {
                "t": "p",
                "inlines": [
                  {
                    "t": "strong",
                    "v": "Permission denied (publickey,password)"
                  }
                ]
              },
              {
                "t": "list",
                "ordered": false,
                "items": [
                  [
                    {
                      "t": "p",
                      "inlines": [
                        {
                          "t": "text",
                          "v": "Ensure you are using the username and password created in Raspberry Pi Imager."
                        }
                      ]
                    }
                  ]
                ]
              }
            ],
            [
              {
                "t": "p",
                "inlines": [
                  {
                    "t": "strong",
                    "v": "Connection refused"
                  }
                ]
              },
              {
                "t": "list",
                "ordered": false,
                "items": [
                  [
                    {
                      "t": "p",
                      "inlines": [
                        {
                          "t": "text",
                          "v": "Wait 1–2 minutes after powering on."
                        }
                      ]
                    }
                  ],
                  [
                    {
                      "t": "p",
                      "inlines": [
                        {
                          "t": "text",
                          "v": "Confirm that SSH was enabled in Raspberry Pi Imager."
                        }
                      ]
                    }
                  ]
                ]
              }
            ]
          ]
        },
        {
          "t": "transition"
        }
      ]
    },
    {
      "id": "graphical-remote-access-options",
      "level": 2,
      "title": "Graphical Remote Access Options",
      "anchors": [],
      "blocks": [
        {
          "t": "p",
          "inlines": [
            {
              "t": "text",
              "v": "If you prefer a graphical interface:"
            }
          ]
        },
        {
          "t": "list",
          "ordered": false,
          "items": [
            [
              {
                "t": "p",
                "inlines": [
                  {
                    "t": "xref",
                    "page": "_shared/appendix/remote_desktop",
                    "section": "remote-desktop",
                    "v": "Remote Desktop"
                  },
                  {
                    "t": "text",
                    "v": ": Enable "
                  },
                  {
                    "t": "strong",
                    "v": "VNC (Virtual Network Computing)"
                  },
                  {
                    "t": "text",
                    "v": " for a full desktop experience on your Pi."
                  }
                ]
              }
            ],
            [
              {
                "t": "p",
                "inlines": [
                  {
                    "t": "link",
                    "href": "https://www.raspberrypi.com/documentation/services/connect.html",
                    "v": "Raspberry Pi Connect"
                  },
                  {
                    "t": "text",
                    "v": ": Use Raspberry Pi Connect for secure remote access from anywhere, directly in a browser."
                  }
                ]
              }
            ]
          ]
        },
        {
          "t": "p",
          "inlines": [
            {
              "t": "text",
              "v": "Now you can control your Raspberry Pi without a monitor, either through SSH for command-line operations, or with VNC / Raspberry Pi Connect for a graphical desktop experience."
            }
          ]
        }
      ]
    }
  ]
}