      "anchors": [],
      "blocks": [
        {
          "t": "p",
          "inlines": [
            {
              "t": "text",
              "v": "This video tutorial focuses on computer vision capabilities in the PiCar-X:"
            }
          ]
        },
        {
          "t": "list",
          "ordered": false,
          "items": [
            [
              {
                "t": "p",
                "inlines": [
                  {
                    "t": "strong",
                    "v": "Introduction to Computer Vision"
                  },
                  {
                    "t": "text",
                    "v": ": Teaches how to detect hand movement, fingers, colors, faces, and read QR codes using the PiCar-X equipped with a camera."
                  }
                ]
              }
            ],
            [
              {
                "t": "p",
                "inlines": [
                  {
                    "t": "strong",
                    "v": "Remote Desktop and Python Code Execution"
                  },
                  {
                    "t": "text",
                    "v": ": Demonstrates using VNC for remote desktop access to the Raspberry Pi and running Python code for computer vision tasks."
                  }
                ]
              }
            ],
            [
              {
                "t": "p",
                "inlines": [
                  {
                    "t": "strong",
                    "v": "Color Detection and Photo Taking"
                  },
                  {
                    "t": "text",
                    "v": ": Shows how to detect different colors and take photos using camera controls."
                  }
                ]
              }
            ],
            [
              {
                "t": "p",
                "inlines": [
                  {
                    "t": "strong",
                    "v": "QR Code and Face Detection"
                  },
                  {
                    "t": "text",
                    "v": ": Explains how to switch between QR code reading and face detection features."
                  }
                ]
              }
            ],
            [
              {
                "t": "p",
                "inlines": [
                  {
                    "t": "strong",
                    "v": "Object Detection"
                  },
                  {
                    "t": "text",
                    "v": ": Discusses the use of built-in functions from SunFounder's VI library for object detection."
                  }
                ]
              }
            ],
            [
              {
                "t": "p",
                "inlines": [
                  {
                    "t": "strong",
                    "v": "Viewing Video on Browser and Mobile"
                  },
                  {
                    "t": "text",
                    "v": ": Teaches how to stream the camera feed to a browser or mobile phone, ensuring they are connected to the same network as the PiCar-X."
                  }
                ]
              }
            ],
            [
              {
                "t": "p",
                "inlines": [
                  {
                    "t": "strong",
                    "v": "Hand Detection"
                  },
                  {
                    "t": "text",
                    "v": ": Covers the use of hand detection feature from the VI library and running corresponding Python code."
                  }
                ]
              }
            ],
            [
              {
                "t": "p",
                "inlines": [
                  {
                    "t": "strong",
                    "v": "Code Editing and Running"
                  },
                  {
                    "t": "text",
                    "v": ": Demonstrates creating, editing, and running Python scripts for various computer vision tasks."
                  }
                ]
              }
            ]
          ]
        },
        {
          "t": "p",
          "inlines": [
            {
              "t": "text",
              "v": "This lesson offers a comprehensive guide to exploring computer vision features in the PiCar-X, including practical demonstrations of color detection, QR code reading, face detection, and hand movement tracking."
            }
          ]
