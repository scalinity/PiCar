            [
              {
                "t": "p",
                "inlines": [
                  {
                    "t": "strong",
                    "v": "Overview"
                  },
                  {
                    "t": "text",
                    "v": ": Teaches how to record HD 1080p videos using the PiCar-X, a Raspberry Pi self-driving robot car kit."
                  }
                ]
              }
            ],
            [
              {
                "t": "p",
                "inlines": [
                  {
                    "t": "strong",
                    "v": "Documentation and Code"
                  },
                  {
                    "t": "text",
                    "v": ": Guides through the PiCar-X documentation for video recording and explains the Python script for recording control (start, pause, continue, stop)."
                  }
                ]
              }
            ],
            [
              {
                "t": "p",
                "inlines": [
                  {
                    "t": "strong",
                    "v": "Remote Desktop Connection"
                  },
                  {
                    "t": "text",
                    "v": ": Demonstrates how to connect remotely to the Raspberry Pi for video recording."
                  }
                ]
              }
            ],
            [
