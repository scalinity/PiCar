          "t": "list",
          "ordered": false,
          "items": [
            [
              {
                "t": "p",
                "inlines": [
                  {
                    "t": "strong",
                    "v": "Basic Control"
                  },
                  {
                    "t": "text",
                    "v": ": Demonstrates controlling the PiCar-X with keyboard commands - \"W\" for forward, \"S\" for backward, \"A\" for left turns, and \"D\" for right turns."
                  }
                ]
              }
            ],
            [
              {
                "t": "p",
                "inlines": [
                  {
                    "t": "strong",
                    "v": "Tilt and Pan of Camera"
                  },
                  {
                    "t": "text",
                    "v": ": Teaches controlling the mounted camera's tilt and pan using \"I\" (up), \"K\" (down), \"J\" (left), and \"L\" (right)."
                  }
                ]
              }
            ],
            [
              {
                "t": "p",
                "inlines": [
                  {
                    "t": "strong",
                    "v": "Code Explanation"
                  },
