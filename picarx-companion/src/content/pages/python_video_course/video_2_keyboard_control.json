                  {
                    "t": "strong",
                    "v": "Running the Code"
                  },
                  {
                    "t": "text",
                    "v": ": Shows how to execute the Python code for keyboard control, including connecting to the PiCar-X."
                  }
                ]
              }
            ],
            [
              {
                "t": "p",
                "inlines": [
                  {
                    "t": "strong",
                    "v": "Exiting Control"
                  },
                  {
                    "t": "text",
                    "v": ": Explains exiting keyboard control by pressing \"Ctrl + C\", returning the robot to its default state."
                  }
                ]
              }
            ]
