{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "policyId",
    "track",
    "unit",
    "basis",
    "sources",
    "definitions",
    "integralLeads",
    "publication"
  ],
  "properties": {
    "policyId": {
      "const": "PX-OWNER-INSTRUCTIONAL-20260930"
    },
    "track": {
      "const": "instructional-only"
    },
    "unit": {
      "const": "mm"
    },
    "basis": {
      "const": "RH-XFORWARD-YLEFT-ZUP"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "path",
          "rawSha256",
          "bytes",
          "privacy",
          "limitations"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "rawSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 1
          },
          "privacy": {
            "enum": [
              "publicSource",
              "privateOwnerEvidence"
            ]
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          }
        }
      }
    },
    "definitions": {
      "type": "array",
      "minItems": 50,
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "definitionId",
          "track",
          "engineeringStatus",
          "representationKind",
          "recipe",
          "boardVariant",
          "semanticRole",
          "sourceRefs",
          "sourceLimitations",
          "canonicalUnknowns",
          "instructionalApproximations",
          "protectedFacts",
          "mustNotDrive",
          "blockerIds",
          "exactOEMIdentity",
          "coordinateScope",
          "expectedRigidSolids",
          "displayRequirements",
          "rightsStatus",
          "notes"
        ],
        "properties": {
          "definitionId": {
            "type": "string"
          },
          "track": {
            "const": "instructional-only"
          },
          "engineeringStatus": {
            "enum": [
              "ENGINEERING_ADMITTED",
              "PARTIAL",
              "BLOCKED"
            ]
          },
          "representationKind": {
            "enum": [
              "authoritative_vendor",
              "nominal_standard_proxy",
              "photo_supported_proxy",
              "documentation_supported_proxy",
              "simplified_visual_proxy",
              "schematic_flexible",
              "abstract_consumable"
            ]
          },
          "recipe": {
            "enum": [
              "screw",
              "standoff",
              "washer",
              "nut",
              "rivet",
              "motor",
              "servo",
              "horn",
              "wheel",
              "board",
              "hat",
              "camera",
              "ultrasonic",
              "grayscale",
              "battery",
              "connector",
              "schematic",
              "abstract"
            ]
          },
          "boardVariant": {
            "enum": [
              null,
              "rpi4",
              "rpi5",
              "rpi-zero-2-w"
            ]
          },
          "semanticRole": {
            "type": [
              "string",
              "null"
            ]
          },
          "sourceRefs": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "sourceLimitations": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "canonicalUnknowns": {
            "type": "array",
            "minItems": 1
          },
          "instructionalApproximations": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "value",
                "unit",
                "basis",
                "sourceRefs",
                "approximationKind",
                "visualPurpose",
                "nonEngineering",
                "blockerIds"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "value": {
                  "type": "number",
                  "minimum": 0
                },
                "unit": {
                  "enum": [
                    "mm",
                    "count"
                  ]
                },
                "basis": {
                  "type": "string"
                },
                "sourceRefs": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "minItems": 1
                },
                "approximationKind": {
                  "enum": [
                    "visualEstimate",
                    "designationNominal",
                    "sourceLimitedReference",
                    "conflictedPresentationSelection"
                  ]
                },
                "visualPurpose": {
                  "type": "string"
                },
                "nonEngineering": {
                  "const": true
                },
                "blockerIds": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "minItems": 1
                }
              }
            }
          },
          "protectedFacts": {
            "type": "object"
          },
          "mustNotDrive": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "blockerIds": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "exactOEMIdentity": {
            "const": "UNRESOLVED"
          },
          "coordinateScope": {
            "type": "string"
          },
          "expectedRigidSolids": {
            "type": "integer",
            "minimum": 0
          },
          "displayRequirements": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "rightsStatus": {
            "type": "object"
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          }
        }
      }
    },
    "integralLeads": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "privatePhotos",
        "vendorBytes",
        "runtimePack"
      ],
      "properties": {
        "privatePhotos": {
          "const": false
        },
        "vendorBytes": {
          "const": false
        },
        "runtimePack": {
          "const": false
        }
      }
    }
  }
}
