    "connector-cream": { "label": "Cream connector plastic", "basis": "assumption", "note": "the owner photo shows a cream JST housing on the ultrasonic module; HAT housings are assumed to match", "baseColor": [0.838, 0.776, 0.610], "metallic": 0.0, "roughness": 0.55 },
    "speaker-dark": { "label": "Dark speaker body", "basis": "assumption", "baseColor": [0.021, 0.021, 0.023], "metallic": 0.0, "roughness": 0.5 },
    "motor-gearbox-yellow": { "label": "Yellow gearbox plastic", "basis": "owner-photo", "baseColor": [0.913, 0.611, 0.013], "metallic": 0.0, "roughness": 0.45 },
