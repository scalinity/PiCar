{
  "contract": "picar-studio-materials/1",
  "track": "presentation-only",
  "colorSpace": "baseColor values are linear RGB (glTF baseColorFactor)",
  "basisKinds": {
    "owner-photo": "finish seen in the owner's private reference photographs; only the finish was taken, never pixels",
    "v40-text": "stated in the locked V40 assembly manual text",
    "v40-illustration": "colour of the part in the V40 manual illustration",
    "assumption": "presentation choice; the real finish is not established"
  },
  "materials": {
    "aluminium-bead-blasted": { "label": "Bead-blasted aluminium plate", "basis": "owner-photo", "baseColor": [0.578, 0.590, 0.604], "metallic": 1.0, "roughness": 0.46, "detail": { "kind": "bead-blast", "roughnessJitter": 0.07, "bumpStrength": 0.015, "scaleMm": 0.35, "renderers": ["blender"] } },
    "nylon-black": { "label": "Black nylon", "basis": "v40-text", "note": "V40 step 1 names the standoffs nylon; screw and rivet finish are assumed to match", "baseColor": [0.011, 0.011, 0.012], "metallic": 0.0, "roughness": 0.52 },
    "steel-zinc": { "label": "Zinc-plated steel", "basis": "assumption", "baseColor": [0.515, 0.527, 0.552], "metallic": 1.0, "roughness": 0.30 },
