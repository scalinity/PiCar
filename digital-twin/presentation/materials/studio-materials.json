    "motor-shaft-white": { "label": "White shaft plastic", "basis": "owner-photo", "baseColor": [0.871, 0.855, 0.807], "metallic": 0.0, "roughness": 0.5 },
    "horn-frosted-white": { "label": "Frosted horn plastic", "basis": "owner-photo", "baseColor": [0.830, 0.855, 0.871], "metallic": 0.0, "roughness": 0.58 },
    "battery-dark": { "label": "Battery pack housing", "basis": "assumption", "baseColor": [0.026, 0.026, 0.029], "metallic": 0.0, "roughness": 0.6 },
    "usb-body-black": { "label": "Black USB body", "basis": "assumption", "baseColor": [0.010, 0.010, 0.011], "metallic": 0.0, "roughness": 0.3 },
    "contact-gold": { "label": "Gold-plated contacts", "basis": "assumption", "note": "header pins and mounting pads; the plating is not measured", "baseColor": [0.944, 0.776, 0.373], "metallic": 1.0, "roughness": 0.28 },
