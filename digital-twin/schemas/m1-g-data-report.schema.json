{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://picar.local/spec/v2/m1-g-data-report.schema.json",
  "type":"object","additionalProperties":false,
  "required":["contractVersion","gate","milestone","status","m0BaselineSha","m1StartSha","branch","identities","checks","testCounts","bindings","limitations","invalidationConditions","m2AllowedAfterCommit"],
  "properties":{
    "contractVersion":{"const":2},"gate":{"const":"G-DATA"},"milestone":{"const":"M1"},
    "status":{"enum":["PASS","FAIL","BLOCKED"]},
    "m0BaselineSha":{"type":"string","pattern":"^[a-f0-9]{40}$"},"m1StartSha":{"type":"string","pattern":"^[a-f0-9]{40}$"},"branch":{"type":"string","minLength":1},
    "identities":{"type":"object","additionalProperties":false,"required":["schemaHash","evidenceHash","modelHash","sourceLockRawSha256","semanticValidatorRawSha256","hashPolicyRawSha256","vectorsRawSha256"],"properties":{"schemaHash":{"$ref":"#/$defs/hash"},"evidenceHash":{"$ref":"#/$defs/hash"},"modelHash":{"$ref":"#/$defs/hash"},"sourceLockRawSha256":{"$ref":"#/$defs/hash"},"semanticValidatorRawSha256":{"$ref":"#/$defs/hash"},"hashPolicyRawSha256":{"$ref":"#/$defs/hash"},"vectorsRawSha256":{"$ref":"#/$defs/hash"}}},
    "checks":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["id","status","detail"],"properties":{"id":{"type":"string","minLength":1},"status":{"enum":["PASS","FAIL","BLOCKED","NOT APPLICABLE"]},"detail":{"type":"string","minLength":1}}}},
    "testCounts":{"type":"object","additionalProperties":false,"required":["tests","passed","failed","schemaMeta","auditedShapeProbes","auditedExamples","auditedSemanticFixtures","m1Positive","m1Negative","hashAcceptedPerLanguage","hashRejectedPerLanguage","companionUnit"],"properties":{"tests":{"type":"integer","minimum":1},"passed":{"type":"integer","minimum":1},"failed":{"type":"integer","minimum":0},"schemaMeta":{"type":"integer","minimum":1},"auditedShapeProbes":{"type":"integer","minimum":1},"auditedExamples":{"type":"integer","minimum":1},"auditedSemanticFixtures":{"type":"integer","minimum":1},"m1Positive":{"type":"integer","minimum":1},"m1Negative":{"type":"integer","minimum":1},"hashAcceptedPerLanguage":{"type":"integer","minimum":1},"hashRejectedPerLanguage":{"type":"integer","minimum":1},"companionUnit":{"type":"integer","minimum":1}}},
    "bindings":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["path","rawSha256","byteLength"],"properties":{"path":{"type":"string","minLength":1},"rawSha256":{"$ref":"#/$defs/hash"},"byteLength":{"type":"integer","minimum":0}}}},
    "limitations":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["scope","status","blockerIds","reason"],"properties":{"scope":{"type":"string"},"status":{"enum":["BLOCKED","NOT APPLICABLE"]},"blockerIds":{"type":"array","items":{"type":"string"}},"reason":{"type":"string","minLength":1}}}},
    "invalidationConditions":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
    "m2AllowedAfterCommit":{"type":"boolean"}
  },
  "$defs":{"hash":{"type":"string","pattern":"^[a-f0-9]{64}$"}},
  "allOf":[{"if":{"properties":{"status":{"const":"PASS"}}},"then":{"properties":{"checks":{"items":{"properties":{"status":{"const":"PASS"}}}},"m2AllowedAfterCommit":{"const":true}}},"else":{"properties":{"m2AllowedAfterCommit":{"const":false}}}}]
}
