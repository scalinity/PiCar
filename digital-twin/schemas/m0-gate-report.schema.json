{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://picar.local/spec/v2/m0-gate-report.schema.json",
  "type": "object",
  "properties": {
    "contractVersion": {
      "const": 2
    },
    "repositoryHead": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "auditedPackageSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "enum": [
              "A",
              "B",
              "C",
              "D",
              "E",
              "F",
              "G"
            ]
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL",
              "BLOCKED"
            ]
          },
          "evidencePaths": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "summary": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "status",
          "evidencePaths",
          "summary"
        ],
        "additionalProperties": false
      },
      "minItems": 7,
      "maxItems": 7
    },
    "nativeFeasibility": {
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED"
      ]
    },
    "nativeBlocker": {
      "type": [
        "string",
        "null"
      ]
    },
    "m1Allowed": {
      "type": "boolean"
    },
    "bindings": {
      "type": "object",
      "properties": {
        "sourceLockSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "inputManifestSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "testManifestSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "outputManifestSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "sourceLockSha256",
        "inputManifestSha256",
        "testManifestSha256",
        "outputManifestSha256"
      ],
      "additionalProperties": false
    },
    "rollbackInstructionsPath": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "contractVersion",
    "repositoryHead",
    "auditedPackageSha256",
    "checks",
    "nativeFeasibility",
    "nativeBlocker",
    "m1Allowed",
    "bindings",
    "rollbackInstructionsPath"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "m1Allowed": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "checks": {
            "items": {
              "properties": {
                "status": {
                  "const": "PASS"
                }
              }
            }
          }
        }
      }
    }
  ]
}
